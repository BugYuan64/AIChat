# AIChat 服务端环境变量样例（复制为 .env 后修改；严禁提交真实秘密）

# 生产环境设为 prod（prod 下启动不再自动 create_all，必须走 Alembic 迁移）
AICHAT_ENV=dev

# 数据库：开发可用 SQLite；生产用 PostgreSQL（asyncpg）
AICHAT_DATABASE_URL=sqlite+aiosqlite:///./aichat.db
# AICHAT_DATABASE_URL=postgresql+asyncpg://aichat:PASSWORD@localhost:5432/aichat

# 认证与加密（生产必须替换为强随机值；两者分开保管，主密钥需与数据库分开备份）
AICHAT_JWT_SECRET=change-me-to-a-long-random-string
AICHAT_CREDENTIAL_MASTER_KEY=

# 可选调优（默认值见 aichat/core/config.py，单位见 contracts/PROTOCOL.md §0）
# AICHAT_RUN_DEADLINE_SECONDS=120
# AICHAT_EVENT_RETENTION_DAYS=7

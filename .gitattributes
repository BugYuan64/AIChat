# 统一换行符：文本文件归一化为 LF，避免 Windows autocrlf 猜测导致混合行尾
* text=auto eol=lf

# 源码与配置（LF）
*.py     text eol=lf
*.pyi    text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.scss   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.mako   text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf

# Windows 专用脚本保持 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制：不做任何转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.db     binary
*.sqlite3 binary
*.woff   binary
*.woff2  binary

# 自动生成的契约不计入语言统计
contracts/openapi.json linguist-generated=true
